
# ========================================
# Avatar Virtual Interactivo - Configuración
# ========================================

# Clave de Anthropic (Claude)
# Obtén tu API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Modelo de Claude a usar
# Opciones: claude-sonnet-4-5-20250929, claude-3-5-sonnet-latest, etc.
# Ver: https://docs.anthropic.com/claude/docs/models-overview
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Proveedor de LLM: anthropic | ollama
# anthropic: Usa Claude API (requiere ANTHROPIC_API_KEY)
# ollama: Usa modelo local (requiere Ollama instalado y corriendo)
LLM_PROVIDER=anthropic

# Ruta donde se guarda la memoria de conversación
MEMORY_PATH=data/prompt_memory.json

# ========================================
# Configuración de Ollama (opcional)
# ========================================
# Si usas LLM_PROVIDER=ollama:
# 1. Instala Ollama: https://ollama.ai/
# 2. Ejecuta: ollama serve
# 3. Descarga un modelo: ollama pull qwen2.5:0.5b
# OLLAMA_MODEL=qwen2.5:0.5b

# ========================================
# AIAvatarKit (Speech-to-Speech) - OPCIONAL
# ========================================

# Habilitar AIAvatarKit (true/false)
AIAVATAR_ENABLED=false

# Proveedor de LLM para AIAvatarKit: gemini | claude | openai
# Por defecto usa Gemini (no requiere OpenAI API key)
AIAVATAR_LLM_PROVIDER=gemini

# ========================================
# Gemini Configuration (RECOMENDADO para AIAvatarKit)
# ========================================

# API Key de Google Gemini
# Obtén tu API key en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de Gemini
# Opciones: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# ========================================
# OpenAI Configuration (OPCIONAL)
# ========================================

# API Key de OpenAI (opcional, para STT alternativo)
# Obtén tu API key en: https://platform.openai.com/
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Modelo de OpenAI para LLM alternativo
# OPENAI_MODEL=gpt-4o

# ========================================
# AIAvatarKit Settings
# ========================================

# Modo debug de AIAvatarKit
AIAVATAR_DEBUG=true

# Idioma para reconocimiento de voz
AIAVATAR_LANGUAGE=es-ES

# Palabras de activación (separadas por comas)
# Dejar vacío para conversación continua
AIAVATAR_WAKEWORDS=Hola,Buenos días,Buenas tardes

# Umbral de volumen para detección de voz (en dB)
AIAVATAR_VOLUME_THRESHOLD=-30.0

# ========================================
# VOICEVOX (TTS para AIAvatarKit) - OPCIONAL
# ========================================

# URL del servidor VOICEVOX (debe estar ejecutándose)
# Descargar: https://voicevox.hiroshiba.jp/
VOICEVOX_BASE_URL=http://127.0.0.1:50021

# ID del speaker de VOICEVOX
# Ver disponibles en: http://127.0.0.1:50021/speakers
VOICEVOX_SPEAKER=1

